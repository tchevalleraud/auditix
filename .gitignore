# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude
.claude/

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# Node
node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Docker
docker-compose.override.yml

# Docker data volumes
data/postgres/
data/rabbitmq/
data/collections/

# Local backups produced by `make backup`
backups/

# Runtime nginx certificates (managed via admin UI)
docker/nginx/certs/*
!docker/nginx/certs/.gitkeep
# Runtime nginx config is regenerated by the admin UI; the committed default.conf
# is the bootstrap copy used until the first apply.

# Symfony
app/var/
app/vendor/
app/.env.local
app/.env.local.php
app/.env.*.local

# NextJS
frontend/node_modules/
frontend/.next/

# Logs
*.log

# Plugin signing keys — NEVER commit the private key
*.priv
app/var/plugin-signing/
